# ─── Auth.js ───────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-me
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MongoDB ───────────────────────────────────────────────
# MongoDB ของ Docker (เปิดอย่างเดียวด้วย: docker compose up -d mongodb) แต่ใช้ database acne_dev
# แยกจาก acne_db ที่ Docker web ใช้ — ห้ามใส่ Atlas ของเว็บจริง
DATABASE_URL=mongodb://localhost:27018/acne_dev?replicaSet=rs0&directConnection=true

# ─── AI Service (FastAPI) ──────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# ต้องเป็นค่าเดียวกับ apps/ai/.env
AI_SERVICE_API_KEY=acne-local-dev-key

# ใส่ APP_ENV=hosted เฉพาะตอน deploy บน Vercel (รูปจะถูกเก็บที่ Vercel Blob)
# APP_ENV=hosted
BLOB_READ_WRITE_TOKEN=your-

# ─── Storage (ดู dev-docs/environments.md) ─────────────────
# แต่ละ environment ต้องมีฐานข้อมูลของตัวเอง — ถ้าเก็บไฟล์ลงดิสก์ (local / file)
# DATABASE_URL ต้องไม่ใช่ Atlas ที่เว็บจริงใช้ (ระบบจะไม่ยอมเริ่ม ยกเว้นตั้ง ALLOW_SHARED_DB=true)
# IMAGE_STORAGE: local | vercel-blob | azure-blob   (ไม่ตั้ง: APP_ENV=hosted → vercel-blob, อื่น ๆ → local)
IMAGE_STORAGE=local
# MODEL_STORAGE: file | mongodb | azure-blob   (file / azure-blob ไม่จำกัดขนาด, mongodb ≤ 15 MB)
MODEL_STORAGE=file
# path แบบเต็มของโฟลเดอร์เก็บรูป (เว้นว่าง = ใช้โฟลเดอร์ apps/images)
STORAGE_PATH=
# โฟลเดอร์เก็บไฟล์โมเดล (ใช้กับ MODEL_STORAGE=file) — ../model-files = apps/model-files (gitignore แล้ว)
MODEL_STORAGE_PATH=../model-files
# ชื่อที่แสดงบนหัวหน้าแอดมิน (เช่น dev, docker, vercel, azure) — ไม่ตั้งจะเดาให้
ENV_NAME=dev
# Azure Blob (ใช้เมื่อ IMAGE_STORAGE / MODEL_STORAGE = azure-blob) — ดู dev-docs/azure-deploy.md
# AZURE_STORAGE_CONNECTION_STRING=
