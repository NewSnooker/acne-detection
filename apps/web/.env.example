# ─── Auth.js ───────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-me
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MongoDB ───────────────────────────────────────────────
DATABASE_URL=

# ─── AI Service (FastAPI) ──────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# ต้องเป็นค่าเดียวกับ apps/ai/.env
AI_SERVICE_API_KEY=acne-local-dev-key
# ความมั่นใจขั้นต่ำของกรอบสิว (0–1) — web กับ ai ต้องเป็นค่าเดียวกัน
AI_CONFIDENCE_THRESHOLD=0.25

# ใส่ APP_ENV=hosted เฉพาะตอน deploy บน Vercel (รูปจะถูกเก็บที่ Vercel Blob)
# APP_ENV=hosted
BLOB_READ_WRITE_TOKEN=your-

# ─── Storage ───────────────────────────────────────────────
# path แบบเต็มของโฟลเดอร์เก็บรูป (เว้นว่าง = ใช้โฟลเดอร์ apps/images)
STORAGE_PATH=
# path แบบเต็มของโฟลเดอร์เก็บไฟล์โมเดล .pt (เว้นว่าง = เก็บใน MongoDB ได้ไม่เกิน 15 MB)
MODEL_STORAGE_PATH=
