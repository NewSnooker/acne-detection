# ─── Auth.js ───────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-me
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MongoDB ───────────────────────────────────────────────
# MongoDB ที่ติดตั้งในเครื่อง (ต้องตั้งเป็น replica set ก่อน — manual/06-developer-guide.md)
# ห้ามใส่ Atlas ของเว็บจริง (Docker ใช้ MongoDB ของตัวเองที่ port 27018)
DATABASE_URL=mongodb://localhost:27017/acne_dev?replicaSet=rs0&directConnection=true

# ─── AI Service (FastAPI) ──────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# ต้องเป็นค่าเดียวกับ apps/ai/.env
AI_SERVICE_API_KEY=acne-local-dev-key
# ความมั่นใจขั้นต่ำของกรอบสิว (0–1) — web กับ ai ต้องเป็นค่าเดียวกัน
AI_CONFIDENCE_THRESHOLD=0.25

# ใส่ APP_ENV=hosted เฉพาะตอน deploy บน Vercel (รูปจะถูกเก็บที่ Vercel Blob)
# APP_ENV=hosted
BLOB_READ_WRITE_TOKEN=your-

# ─── Storage (ดู dev-docs/environments.md) ─────────────────
# แต่ละ environment ต้องมีฐานข้อมูลของตัวเอง — ถ้าเก็บไฟล์ลงดิสก์ (local / file)
# DATABASE_URL ต้องไม่ใช่ Atlas ที่เว็บจริงใช้ (ระบบจะไม่ยอมเริ่ม ยกเว้นตั้ง ALLOW_SHARED_DB=true)
# IMAGE_STORAGE: local | vercel-blob   (ไม่ตั้ง: APP_ENV=hosted → vercel-blob, อื่น ๆ → local)
IMAGE_STORAGE=local
# MODEL_STORAGE: file | mongodb        (file = โฟลเดอร์ MODEL_STORAGE_PATH ไม่จำกัดขนาด, mongodb ≤ 15 MB)
MODEL_STORAGE=file
# path แบบเต็มของโฟลเดอร์เก็บรูป (เว้นว่าง = ใช้โฟลเดอร์ apps/images)
STORAGE_PATH=
# โฟลเดอร์เก็บไฟล์โมเดล (ใช้กับ MODEL_STORAGE=file) — ../model-files = apps/model-files (gitignore แล้ว)
MODEL_STORAGE_PATH=../model-files
# ชื่อที่แสดงบนหัวหน้าแอดมิน (เช่น dev, docker, vercel, azure) — ไม่ตั้งจะเดาให้
ENV_NAME=dev
