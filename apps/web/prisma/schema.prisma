// ─── Prisma Schema — MongoDB ────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

// ─── User ──────────────────────────────────────────────────
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // null ถ้า login ด้วย Google
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  analyses       Analysis[]
  uploadedModels AiModel[]
}

// ─── Auth.js required models ───────────────────────────────
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── AI Model Registry ─────────────────────────────────────
model AiModel {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  version        String
  description    String?
  filePath       String // provider "file" = ชื่อไฟล์ในโฟลเดอร์ MODEL_STORAGE_PATH, อื่น ๆ = ""
  modelData      Bytes? // ไฟล์ .pt ทั้งไฟล์ (เฉพาะ provider "mongodb" ไม่เกิน 15 MB — แบบเก่า/seed)
  // "chunks" = หั่นเก็บใน AiModelChunk (แบบปัจจุบัน ไม่จำกัดขนาด ทุก environment เห็นไฟล์เดียวกัน)
  // "mongodb" / "file" = แบบเก่า ยังอ่านได้ ("local" เป็นค่าเก่ากว่านั้น ไม่ได้ใช้แล้ว)
  provider       String   @default("local")
  sizeBytes      Int? // ขนาดจริง (byte) ใช้ตรวจว่าชิ้นครบ — แบบเก่าไม่มี
  chunkCount     Int? // จำนวนชิ้นที่ต้องมี (provider "chunks")
  uploadComplete Boolean? // false = ยังอัปโหลดไม่ครบ ห้ามตั้งเป็นโมเดลหลัก (null = แบบเก่า ถือว่าครบ)
  fileName       String
  sizeMb         Float
  isActive       Boolean  @default(true)
  // ค่าประเมินโมเดล (ข้อ 1.3.3.3) เก็บเป็นร้อยละ 0–100 แอดมินกรอกจากผลทดสอบ ไม่มี = null
  mAP50          Float?
  precision      Float?
  recall         Float?
  f1Score        Float?
  accuracy       Float?
  uploadedBy     String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User           @relation(fields: [uploadedBy], references: [id])
  analyses Analysis[] // โมเดล 1 ตัว ถูกใช้ในหลายการวิเคราะห์
  chunks   AiModelChunk[]
}

// ไฟล์โมเดลหั่นเป็นชิ้นละไม่เกิน 4 MB — เอกสาร MongoDB ใหญ่ได้ไม่เกิน 16 MB
// และ Vercel รับ/ส่งได้ไม่เกิน 4.5 MB ต่อคำขอ จึงอัปโหลดและดาวน์โหลดทีละชิ้น
model AiModelChunk {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  modelId String @db.ObjectId
  index   Int
  data    Bytes // ต้องส่ง Buffer (Uint8Array จะกลายเป็น null)

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, index])
}

// ─── Image Registry ───────────────────────────────────────
model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName  String // ชื่อไฟล์ (local) หรือ pathname (vercel-blob)
  url       String? // Public URL ของ Vercel Blob (local = null)
  provider  String   @default("local") // "local" หรือ "vercel-blob"
  createdAt DateTime @default(now())

  analysis Analysis?
}

// ─── Analysis Result ───────────────────────────────────────
model Analysis {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String  @db.ObjectId
  modelId String? @db.ObjectId

  // ── 1-to-1 Relation กับ Image ──
  imageId String @unique @db.ObjectId
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // ผลจาก YOLO
  detections Json // [{type, confidence, bbox:{x1,y1,x2,y2}}]
  counts     Json // {blackhead:2, cyst:0, ...}
  total      Int
  severity   Severity

  createdAt DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
}
