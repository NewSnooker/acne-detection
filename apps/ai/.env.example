AI_SERVICE_API_KEY=acne-local-dev-key
# ความมั่นใจขั้นต่ำของกรอบสิว (0–1) — web กับ ai ต้องเป็นค่าเดียวกัน
AI_CONFIDENCE_THRESHOLD=0.25
# Test-Time Augmentation (true/false) — เจอสิวมากขึ้น แต่ช้าลง 2–3 เท่า — web กับ ai ควรตั้งเหมือนกัน
AI_USE_TTA=false
DEBUG=true
STORAGE_PATH=./storage
MODELS_PATH=./models

# ไม่บังคับ: host ที่ยอมให้ดาวน์โหลดรูปผ่าน URL (ค่าเริ่มต้นคือ Vercel Blob)
# ALLOWED_IMAGE_HOSTS=.public.blob.vercel-storage.com
# ไม่บังคับ: host ของเว็บที่ยอมให้ดาวน์โหลดไฟล์โมเดล (เว้นว่าง = ไม่จำกัด)
# ALLOWED_MODEL_HOSTS=my-app.vercel.app
