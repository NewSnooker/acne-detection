# ─── ค่าที่เปลี่ยนได้สำหรับ Docker ───────────────────────────
# ไฟล์นี้ไม่บังคับ — ระบบรันได้โดยไม่ต้องมี .env
# ถ้าอยากเปลี่ยนค่าเริ่มต้น ให้คัดลอกไฟล์นี้เป็น .env (วางข้าง docker-compose.yml)

# port ของเว็บบนเครื่อง
WEB_PORT=3000

# port ของ MongoDB ใน Docker ที่เปิดออกมาบนเครื่อง (เข้าได้เฉพาะเครื่องนี้)
# ค่าเริ่มต้น 27018 ไม่ชนกับ MongoDB ที่ติดตั้งในเครื่อง (27017)
MONGO_PORT=27018

# key ลับสำหรับเข้ารหัส session — ควรเปลี่ยนถ้าเปิดให้คนอื่นเข้าใช้
AUTH_SECRET=acne-local-docker-secret-change-me

# key ที่ web ใช้เรียก ai (ระบบใส่ค่าเดียวกันให้ทั้งสองฝั่งเอง)
AI_SERVICE_API_KEY=acne-local-docker-key

# บัญชีผู้ดูแลระบบเริ่มต้น (มีผลเฉพาะตอนฐานข้อมูลยังไม่มีแอดมิน)
SEED_ADMIN_EMAIL=admin@acne.local
SEED_ADMIN_PASSWORD=Admin1234

# การเข้าสู่ระบบด้วย Google ไม่ได้ตั้งที่ไฟล์นี้ — ใส่ GOOGLE_CLIENT_ID และ
# GOOGLE_CLIENT_SECRET ในไฟล์ apps/web/.env (ดู README)

# ความมั่นใจขั้นต่ำของกรอบสิว และ Test-Time Augmentation (ใช้ทั้ง web และ ai)
# AI_CONFIDENCE_THRESHOLD=0.25
# AI_USE_TTA=false
